# Copy to .env and fill in the secrets. Never commit .env.
#
# Application ID and public key come from
# https://discord.com/developers/applications
# The public key is not the bot token.

DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Message listening uses the gateway, so HTTP interactions stay off
# unless you set an Interactions Endpoint URL in the Developer Portal.
ENABLE_HTTP_INTERACTIONS=false
HTTP_INTERACTIONS_HOST=0.0.0.0
HTTP_INTERACTIONS_PORT=8080

MAX_HISTORY=12
MAX_QUIET_HOURS=168
